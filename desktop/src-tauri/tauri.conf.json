{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E-Library",
  "version": "0.3.1",
  "identifier": "com.wbs.elibrary",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "",
    "beforeBundleCommand": "powershell -NoProfile -Command \"New-Item -ItemType Directory -Force agent-dist | Out-Null; Copy-Item src-tauri/target/release/agent.exe agent-dist/agent.exe -Force\""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "E-Library",
        "fullscreen": true,
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": ["../agent-dist/agent.exe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
